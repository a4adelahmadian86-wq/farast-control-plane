{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FARAST Work Item Checkpoint",
  "type": "object",
  "required": [
    "work_item_id",
    "run_id",
    "checkpoint_version",
    "created_at_utc",
    "completed_step_ids",
    "remaining_step_ids",
    "progress_percentage",
    "owner",
    "next_action"
  ],
  "properties": {
    "work_item_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "checkpoint_version": {
      "const": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_step_id": {
      "type": "string"
    },
    "completed_step_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_step_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "progress_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array"
    },
    "owner": {
      "type": "object",
      "required": [
        "actor",
        "chat_id",
        "fencing_token",
        "lease_expires_at_utc"
      ],
      "properties": {
        "actor": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "fencing_token": {
          "type": "integer"
        },
        "lease_expires_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "next_action": {
      "type": "string"
    },
    "execution_progress_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "acceptance_progress_percentage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "overall_completion_percentage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "progress_calculation_version": {
      "type": "string"
    },
    "acceptance_criteria_counts": {
      "type": "object"
    },
    "required_step_counts": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
