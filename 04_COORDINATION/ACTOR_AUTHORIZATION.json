{
  "schema_version": "1.0",
  "description": "Explicit command authorization for FARAST multi-chat coordination. Add exact GitHub logins to actor_roles only after owner approval; SENIOR_MANAGER also requires actor_scopes with exact repositories and resource_key_prefixes. Missing scope denies all manager commands.",
  "roles": {
    "OWNER": [
      "claim",
      "heartbeat",
      "release",
      "status",
      "block",
      "unblock",
      "review",
      "reopen",
      "accept",
      "progress",
      "step",
      "criterion",
      "checkpoint",
      "refresh"
    ],
    "SENIOR_MANAGER": [
      "claim",
      "heartbeat",
      "release",
      "status",
      "block",
      "unblock",
      "review",
      "reopen",
      "accept",
      "progress",
      "step",
      "criterion",
      "checkpoint"
    ],
    "WORKER": [
      "claim",
      "heartbeat",
      "release",
      "status",
      "block",
      "review",
      "progress",
      "step",
      "criterion",
      "checkpoint",
      "accept"
    ],
    "READ_ONLY": [
      "status",
      "progress"
    ]
  },
  "default_association_roles": {
    "OWNER": "OWNER",
    "COLLABORATOR": "WORKER",
    "MEMBER": "WORKER"
  },
  "actor_roles": {},
  "actor_scopes": {}
}
