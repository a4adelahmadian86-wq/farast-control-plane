{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FARAST Hierarchical Work Item",
  "type": "object",
  "required": [
    "schema_version",
    "work_item_id",
    "title",
    "parent_goal_ids",
    "parent_exp_ids",
    "status",
    "target_repository",
    "resource_keys",
    "dependencies",
    "steps",
    "acceptance_criteria",
    "priority",
    "created_at_utc",
    "write_policy",
    "priority_source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parent_goal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_exp_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_cp_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
      }
    },
    "allocation_provenance": {
      "type": "object",
      "required": [
        "allocator_work_item_id",
        "allocator_issue_number",
        "actor",
        "chat_id",
        "run_id",
        "fencing_token",
        "branch",
        "allocated_at_utc"
      ],
      "properties": {
        "allocator_work_item_id": {
          "const": "WI-GOAL-ALLOCATOR-001"
        },
        "allocator_issue_number": {
          "const": 11
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "chat_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1
        },
        "branch": {
          "type": ["string", "null"]
        },
        "allocated_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "parent_work_item_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "status": {
      "enum": [
        "BACKLOG",
        "READY",
        "CLAIMED",
        "IN_PROGRESS",
        "BLOCKED",
        "REVIEW_REQUIRED",
        "PARTIALLY_ACCEPTED",
        "ACCEPTED",
        "REJECTED",
        "CANCELLED"
      ]
    },
    "target_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "resource_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "work_item_id"
        ],
        "properties": {
          "work_item_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "title"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "validation_status": {
            "enum": [
              "NOT_RUN",
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validated_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "validated_by": {
            "type": "string"
          },
          "validation_note": {
            "type": "string"
          },
          "expected_output": {
            "type": "string"
          },
          "evidence_requirement": {
            "type": "string"
          },
          "estimate_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        }
      }
    },
    "weighting": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "title"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "validation_status": {
            "enum": [
              "NOT_RUN",
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validated_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "validated_by": {
            "type": "string"
          },
          "validation_note": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "evidence_requirement": {
            "type": "string"
          }
        }
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "ready_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint_ref": {
      "type": "string"
    },
    "owner": {
      "type": "object"
    },
    "next_action": {
      "type": "string"
    },
    "write_policy": {
      "type": "string",
      "enum": [
        "READ_ONLY",
        "WRITE_REQUIRES_OWNER_APPROVAL",
        "WRITE_ALLOWED"
      ]
    },
    "priority_source": {
      "type": "string",
      "enum": [
        "OWNER_ASSIGNED",
        "DEFAULT_POLICY"
      ]
    },
    "owner_approval_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Required for WRITE_REQUIRES_OWNER_APPROVAL. For WRITE_ALLOWED on a4adelahmadian86-wq/non, it must exactly equal the canonical URL of the owner-created Issue whose body records the explicit owner decision."
    },
    "effort_estimate_minutes": {
      "type": "integer",
      "minimum": 20,
      "maximum": 30,
      "description": "Target focused effort for a standard deep leaf; not a forced minimum duration."
    },
    "effort_rationale": {
      "type": "string",
      "minLength": 1
    },
    "depth_profile": {
      "type": "object",
      "required": [
        "profile_version",
        "min_substantive_steps",
        "min_acceptance_criteria",
        "min_deliverables"
      ],
      "properties": {
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "min_substantive_steps": {
          "type": "integer",
          "minimum": 6
        },
        "min_acceptance_criteria": {
          "type": "integer",
          "minimum": 4
        },
        "min_deliverables": {
          "type": "integer",
          "minimum": 3
        },
        "target_effort_minutes": {
          "type": "integer",
          "minimum": 20,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "deliverables": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "deliverable_id",
          "description",
          "evidence_requirement"
        ],
        "properties": {
          "deliverable_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_requirement": {
            "type": "string",
            "minLength": 1
          },
          "artifact_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_weighting": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "requested_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "analysis",
          "proposal_only",
          "control_plane_write",
          "control_plane_merge",
          "control_plane_authorization_change",
          "repository_write",
          "product_implementation",
          "destructive_data_change",
          "database_migration",
          "authorization_change",
          "security_sensitive_change",
          "audit_log_change",
          "architecture_implementation",
          "hosting_deployment",
          "legal_policy_change",
          "merge",
          "acceptance",
          "security_acceptance",
          "production_release"
        ]
      },
      "description": "Explicit operation scope for every WRITE_ALLOWED Work Item. Sensitive action identifiers are checked against the canonical operation_gates registry; omitted scope is not inferred for new write tasks."
    },
    "operation_scope_version": {
      "const": "1.0",
      "description": "Versioned explicit operation-scope contract. New write-enabled Work Items set this field and provide requested_operations; legacy Work Items without it remain parseable but write claims fail closed until migrated."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "target_repository": {
            "const": "a4adelahmadian86-wq/non"
          },
          "write_policy": {
            "const": "WRITE_ALLOWED"
          }
        },
        "required": [
          "target_repository",
          "write_policy"
        ]
      },
      "then": {
        "required": [
          "owner_approval_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation_scope_version": {
            "const": "1.0"
          }
        },
        "required": [
          "operation_scope_version"
        ]
      },
      "then": {
        "required": [
          "requested_operations"
        ]
      }
    },
    {
      "if": {
        "required": [
          "requested_operations"
        ]
      },
      "then": {
        "required": [
          "operation_scope_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "write_policy": {
            "const": "WRITE_ALLOWED"
          }
        },
        "required": [
          "write_policy"
        ],
        "not": {
          "properties": {
            "work_item_id": {
              "enum": [
                "WI-GOAL-ALLOCATOR-001",
                "WI-NON-IMPLEMENTATION-VERTICAL-SLICE-001",
                "WI-NON-WRITE-POLICY-COORDINATOR-001",
                "WI-PR16-SPEC-REPAIR-001",
                "WI-OPERATION-GATE-MODEL-001",
                "WI-CI-001",
                "WI-READONLY-EVIDENCE-ACCEPTANCE-001"
              ]
            }
          },
          "required": [
            "work_item_id"
          ]
        }
      },
      "then": {
        "required": [
          "operation_scope_version",
          "requested_operations"
        ]
      },
      "description": "WI-CI-001 is a schema-only validation fixture; runtime work-item-core rejects it as an unlisted legacy WRITE_ALLOWED Work Item."
    }
  ]
}
