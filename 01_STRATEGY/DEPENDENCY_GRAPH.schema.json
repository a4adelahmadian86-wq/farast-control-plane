{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FARAST Typed Dependency and Operation Gate Graph",
  "type": "object",
  "required": [
    "version",
    "policy",
    "nodes",
    "operation_gates"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "hard_gates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EXP-[0-9]{2}$"
          },
          "hard_gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EXP-[0-9]{2}$"
            }
          },
          "soft_inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EXP-[0-9]{2}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "operation_gates": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_gate_ids",
          "required_work_item_ids",
          "owner_authorization_required",
          "evidence_requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "control_plane_write",
              "control_plane_merge",
              "control_plane_authorization_change",
              "repository_write",
              "product_implementation",
              "destructive_data_change",
              "database_migration",
              "authorization_change",
              "security_sensitive_change",
              "audit_log_change",
              "architecture_implementation",
              "hosting_deployment",
              "legal_policy_change",
              "merge",
              "acceptance",
              "security_acceptance",
              "production_release"
            ]
          },
          "source_gate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to_exp_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EXP-[0-9]{2}$"
            }
          },
          "applies_to_target_repositories": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            }
          },
          "required_work_item_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
            }
          },
          "owner_authorization_required": {
            "type": "boolean"
          },
          "evidence_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
